-- NuSMV model generated by spar mode_reachability analysis
-- AS5506 §12 mode state machines

MODULE Node.Confined_session()
  VAR
    state : {loading, preflight, confined, refused, exited};

  INIT
    state = loading

  TRANS
    case
      state = confined : next(state) = exited;
      state = loading : next(state) in {preflight, refused};
      state = preflight : next(state) in {confined, refused};
      TRUE : next(state) = state;
    esac

  SPEC EF state = preflight  -- reachable from loading
  SPEC EF state = confined  -- reachable from loading
  SPEC EF state = refused  -- reachable from loading
  SPEC EF state = exited  -- reachable from loading

MODULE main
  VAR
    Node.Confined_session : Node.Confined_session();

  SPEC EF Node.Confined_session.state = preflight  -- Node.Confined_session can reach preflight
  SPEC EF Node.Confined_session.state = confined  -- Node.Confined_session can reach confined
  SPEC EF Node.Confined_session.state = refused  -- Node.Confined_session can reach refused
  SPEC EF Node.Confined_session.state = exited  -- Node.Confined_session can reach exited
